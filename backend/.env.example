DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Mapas e logística sem dependência de APIs pagas
TILE_PROVIDER=osm
ROUTE_PROVIDER=openrouteservice
OPENROUTESERVICE_API_KEY=
GEOCODING_PROVIDER=nominatim
TOLL_PROVIDER=internal
TOLL_ROUTE_TOLERANCE_METERS=200
USE_ROUTE_CACHE=True
ROUTE_CACHE_TTL_DAYS=30

# MDF-e / SEFAZ (gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
MDFE_ENCRYPTION_KEY=
# Produção exige também confirmação administrativa na interface. Mantenha False até homologar.
MDFE_ENABLE_PRODUCTION=False
MDFE_CONNECT_TIMEOUT_SECONDS=15
MDFE_READ_TIMEOUT_SECONDS=45
# O padrão usa a AC Raiz ICP-Brasil v10 pública incluída no projeto.
# MDFE_CA_BUNDLE=/caminho/privado/cadeia-icp-brasil.pem
# Normalmente não é necessário. Informe apenas se a infraestrutura usar uma CA corporativa.
# MDFE_PORTAL_CA_BUNDLE=/caminho/para/ca-publica-ou-corporativa.pem
# Política opcional para produção: aceita do Portal somente para exibir motorista e destino
# quando a assinatura do conteúdo não puder ser validada. Esses dados não entram no encerramento.
MDFE_ALLOW_INFORMATIONAL_PORTAL_XML=False
# SOMENTE diagnóstico local com DEBUG=True; nunca habilite em servidor de produção.
MDFE_ALLOW_UNVERIFIED_PORTAL_XML=False
# MDFE_MUNICIPALITIES_FILE=/caminho/municipiosBrasil.json
